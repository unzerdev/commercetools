{
  "name": "@psp/processor",
  "version": "0.0.1",
  "description": "Payment provider integration template",
  "main": "dist/server.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "node_modules/.bin/nodemon -q dist/main.js",
    "start:debug": "node dist/infrastructure/connectors/post-deploy.js && node_modules/.bin/nodemon --inspect=9229 -q dist/main.js",
    "lint": "prettier --check \"**/**/*.{ts,js,json}\" && eslint src test",
    "lint:fix": "prettier --write \"**/**/*.{ts,js,json}\" && eslint --fix src test",
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc --sourceMap false && npm run copy-assets",
    "copy-assets": "node -e \"fs.cpSync('src/providers/psp/assets/logos', 'dist/providers/psp/assets/logos', { recursive: true })\"",
    "build:debug": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -sourceMap && npm run copy-assets",
    "gcp-build": "npm run build",
    "dev": "ts-node src/main.ts",
    "watch": "nodemon --watch \"src/**\" --ext \"ts,json\" --ignore \"src/**/*.spec.ts\" --exec \"ts-node src/main.ts\"",
    "test": "jest --detectOpenHandles",
    "test:watch": "jest --watch --detectOpenHandles",
    "connector:post-deploy": "node dist/infrastructure/connectors/post-deploy.js",
    "connector:pre-undeploy": "node dist/infrastructure/connectors/pre-undeploy.js"
  },
  "keywords": [],
  "author": "Logeecom",
  "license": "ISC",
  "dependencies": {
    "@commercetools-backend/loggers": "27.9.0",
    "@commercetools/connect-payments-sdk": "1.2.0",
    "@fastify/autoload": "6.5.0",
    "@fastify/cors": "11.3.0",
    "@fastify/formbody": "8.0.2",
    "@fastify/http-proxy": "11.6.0",
    "@fastify/request-context": "7.0.0",
    "@fastify/type-provider-typebox": "6.1.0",
    "@sinclair/typebox": "0.34.52",
    "dotenv": "17.4.2",
    "fastify": "^5.12.1",
    "fastify-plugin": "6.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.6",
    "@eslint/js": "10.0.1",
    "@jest/globals": "30.4.1",
    "@types/jest": "30.0.0",
    "@types/node": "26.1.2",
    "@typescript-eslint/eslint-plugin": "8.66.0",
    "@typescript-eslint/parser": "8.66.0",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jest": "29.16.0",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.9.0",
    "jest": "30.4.2",
    "js-yaml": "5.2.3",
    "node-fetch": "3.3.2",
    "nodemon": "3.1.14",
    "prettier": "3.9.6",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "typescript": "6.0.3"
  },
  "overrides": {
    "path-to-regexp": "3.3.0",
    "lodash": "4.18.1",
    "@typescript-eslint/utils": "8.66.0",
    "@babel/runtime": "7.26.10",
    "@babel/runtime-corejs3": "7.26.10",
    "diff": "9.0.0",
    "flatted": "3.4.2"
  }
}
