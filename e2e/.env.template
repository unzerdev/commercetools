# Connector E2E harness — environment template.
#
# Copy to `.env` (gitignored) and fill in. These tests drive the PROCESSOR's HTTP surface directly;
# they start no server. Bring the processor up EXTERNALLY first:
#
#   - processor   http://localhost:8080   (PROCESSOR_URL below)
#
# The fail-closed webhook negatives run against the local stack alone. The legs that need a real
# capability-URL token gate on ENCRYPTION_KEY, and the settlement-lifecycle case needs a connected
# Unzer SANDBOX and gates on UNZER_SANDBOX_* (it skips when they are absent).

# The processor base URL every request is built against.
PROCESSOR_URL=http://localhost:8080

# The store key the webhook POST path targets (the CT project key for a default single-store stack).
# webhook.spec.ts skips its fail-closed negatives without it.
E2E_STORE_KEY=

# --- Webhook capability-URL token (webhook.spec.ts) ----------------------------------------------
# The processor's ENCRYPTION_KEY — the SAME value the processor stack was started with. The webhook
# tests derive the per-store capability-URL token from it in Node (base64url HMAC-SHA256 over
# "psp-webhook-url-token:v1:" + storeKey — see support/webhook-token.ts); without it the valid-token
# legs are skipped and only the fail-closed negatives run. Never commit the real value.
ENCRYPTION_KEY=

# --- Unzer sandbox (gates the settlement-lifecycle leg) ------------------------------------------
# The store must be CONNECTED to this sandbox in the MC app. Without it that leg skips; the
# fail-closed negatives still run.
UNZER_SANDBOX_PUBLIC_KEY=
UNZER_SANDBOX_PRIVATE_KEY=
