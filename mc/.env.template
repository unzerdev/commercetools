# ==============================================================================
# Merchant Center Custom Application (dev) env template — copy to `.env` and fill
# in real values. Never commit `.env` (it is gitignored; only this template is tracked).
#
# These keys are the local-development values custom-application-config.mjs reads
# from the environment; every one has a fallback there, so a checkout with no `.env`
# still builds (which is what `commercetools connect validate` does). Connect
# deployments override them at build/deploy time, and the four deployment keys must
# then be set TOGETHER: CUSTOM_APPLICATION_ID, APPLICATION_URL, PROCESSOR_URL and
# ENTRY_POINT_URI_PATH. Placeholders only — no real secrets in the template.
# ==============================================================================

ENABLE_NEW_JSX_TRANSFORM="true"
FAST_REFRESH="true"

# commercetools cloud region identifier (e.g. gcp-eu, aws-us).
CLOUD_IDENTIFIER="gcp-eu"

# commercetools project key the dev app opens against.
CTP_INITIAL_PROJECT_KEY="your-project-key"

# Custom Application id — a local placeholder in dev; the real id in a deployment.
CUSTOM_APPLICATION_ID="__local-development__"

# The app's own dev URL.
APPLICATION_URL="https://localhost:3001"

# The connector processor origin the app reaches over the MC forward-to proxy, and
# the CSP connect-src origin declared in custom-application-config.mjs.
PROCESSOR_URL="http://localhost:8080"

# This app's entry point. It DERIVES the MC permission the operator must hold
# (canManage<TitleCase(this)>), which the processor enforces as the brand default
# `managePermission` — the two must agree or every config mutation answers 403.
# A DISTRIBUTION value: the brand build derives both sides from the same brand
# configuration. It must also match the entry point the Custom Application is
# registered under in the Merchant Center.
ENTRY_POINT_URI_PATH="unzer-payments"
