# Code Editor directories and files
.idea
.connect
.vscode

# Agent tooling scratch space — working state, never history.
.claude/

# Secret-bearing env files — a glob, NOT an exact `.env`, so scratch/scenario
# files (.env.bckp, env_<scenario>.env, .env.local, .examples.env) can never be
# staged by a broad `git add`. Only the placeholder template stays tracked.
.env
.env.*
!.env.template
# The hyphen form too: `deployment/onprem/.env-sample` teaches exactly that convention, so a
# filled-in `.env-live` is the natural next file - and `.env.*` does not match it.
.env-*
!.env-sample
env_*.env
.examples.env

# Local no-docker dev runner logs (scripts/dev-local.sh)
.dev-logs/

# Stray yarn lockfile — the apps are standalone npm packages (no yarn); a tool
# running `yarn` at the repo root leaves an empty autogenerated lockfile artifact.
yarn.lock

# Build/install output anywhere in the tree, even if a sub-package .gitignore is missing
**/node_modules/
**/dist/
**/coverage/

# Playwright artifacts
e2e/test-results/
e2e/playwright-report/
