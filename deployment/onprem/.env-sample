# Annotated reference for the Connect payment connector's env contract (processor service plus the two
# Merchant Center bundles), carrying a filled example value and the rationale for every key.
#
# The file the hardened on-prem stack is COPIED from is the sibling `.env.template` — it is what
# `docker-compose.yml` reads and it additionally declares the nginx front, TLS, scheduler and
# base-image keys this reference omits. Read this file to understand a key; copy that one to deploy.
# Never commit a filled `.env`.
#
# The key set mirrors the processor's env contract (processor/src/infrastructure/config)
# and connect.yaml — on-prem uses the exact same contract as a Connect deployment.

# --- commercetools Composable Commerce API client -----------------------------
# API client scopes (per connect.yaml): manage_payments, manage_orders,
# view_sessions, view_api_clients, manage_checkout_payment_intents,
# introspect_oauth_tokens, manage_types, view_types,
# view_stores (store-existence authorization on the /operations config endpoints),
# view_customers (the signed-in shopper's date of birth, which buy-now-pay-later
# methods require).
CTP_PROJECT_KEY=your-project-key
CTP_CLIENT_ID=your-client-id
CTP_CLIENT_SECRET=your-client-secret

# --- commercetools region ({cloudRegion}.{cloudProvider}) ---------------------
# Example regions: europe-west1.gcp, us-central1.gcp, australia-southeast1.gcp,
# eu-central-1.aws. The six commercetools URLs (auth/api/session/checkout + the
# MC-API jwks/jwtIssuer) are DERIVED from this one token. The processor validates
# JWTs issued by the Merchant Center forward-to proxy against the mc-api JWKS of
# that region; there is no mock issuer in any environment.
CTP_REGION=europe-west1.gcp

# --- Service tuning ------------------------------------------------------------
# Timeout (ms) for the /operations/status health check of downstream systems.
HEALTH_CHECK_TIMEOUT=5000
# Winston log level: error | warn | info | debug
LOGGER_LEVEL=info

# --- Store-level authorization (SEC hardening) ---------------------------------
# The MC permission an operator must hold on EVERY merchant /operations endpoint — the store
# connection (read/write the store config, testconnection, upload-logo, disconnect) AND the
# Merchant Center payment panel, which CAPTURES, REFUNDS and CANCELS real money — is a BRAND value
# (providers/psp/brand.defaults.json `managePermission`, authored there), NOT an env var. commercetools
# derives the claim it grants from the entry point the MC application is REGISTERED under, as
# `can` + `Manage` + PascalCase(entryPointUriPath), so the brand value MUST match ENTRY_POINT_URI_PATH
# below (`unzer-payments` -> `canManageUnzerPayments`) or every config mutation answers 403. Grant it
# only to the MC Teams you trust to act on payments, and grant it to the operator's MC Team too: else the
# token carries no user_permissions claim and the manage routes fail closed with 403. The config
# endpoints also verify the effective store key resolves to a real project store (needs view_stores)
# and reject an unknown store 403.

# --- Unzer credentials ----------------------------------------------------------
# NOT environment variables. The Unzer public/private API key pair is entered per store in the
# Merchant Center application and stored encrypted in the unzer-connector-config Custom Object,
# which is also where the per-store mode, host and webhook overrides live.

# --- Encryption keyring — SECRET, REQUIRED ----------------------------------------
# AES-256-GCM key (64 hex chars used raw, otherwise SHA-256-derived) — the CURRENT key of the
# encryption keyring. New ciphertext is written under it in the v1 key-id envelope
# (v1:<key-id>:<iv>:<tag>:<ciphertext>). It encrypts the secret fields of the per-store
# unzer-connector-config Custom Object. REQUIRED: post-deploy and the processor both refuse to run
# without it. The boot guard also refuses a WEAK value — a
# placeholder (this bracketed seed included) or anything under 32 characters — because the webhook
# capability-URL token is derived from this key. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=<openssl rand -hex 32>
# OPTIONAL previous key of the encryption keyring — enables zero-downtime rotation. Decryption falls
# back to it by envelope key-id; new ciphertext is always written under the current ENCRYPTION_KEY.
# When set, post-deploy re-encrypts existing unzer-connector-config secrets under the current key
# and re-registers every credentialed store environment's webhook subscription with the current-key
# capability URL (best-effort, idempotent).
ENCRYPTION_KEY_PREVIOUS=

# --- PSP deployment config ------------------------------------------------------
# The vendor API host (test and live), the integrator identifier and the telemetry header name are
# BRAND values (providers/psp/brand.defaults.json: `defaultHost` / `defaultHostLive`, `integrator`,
# `telemetryHeaderName`) — NOT env vars. SANDBOX vs LIVE is picked by the resolved store's mode,
# and the active environment block's `host` above overrides both per store.
# The webhook URL is DERIVED: {processor origin}/webhooks/{storeKey}/{token} — the origin comes from
# the request's Host header and the token is a MAC derived from ENCRYPTION_KEY; a per-store
# `webhookUrl` override wins verbatim and must embed a valid token.

# --- Return leg ----------------------------------------------------------------
# The processor's OWN public /return endpoint base is DERIVED: {processor origin}/return.
# createPayment appends `?ctPaymentId=<id>` and hands it to the PSP as the redirect target so the
# return leg can authenticate the callback against the payment id it stamped, then reflect the
# definitive status.
# Return-leg hardening (SEC-M1 / CR-M3). Comma-separated allowlist of permitted storefront
# ORIGINS a shopper return URL may target; off-allowlist is rejected at intake and never
# used for a 302. EMPTY/unset admits every http(s) origin (non-http(s) targets are always refused);
# set it in production.
PSP_ALLOWED_RETURN_ORIGINS=https://your-shop.example.com
# The single safe sink the return leg redirects to on ANY failure. REQUIRED — the shopper is
# never 500'd and payment existence stays unobservable.
PSP_RETURN_FAILURE_URL=https://your-shop.example.com/checkout/payment-failed

# --- 3DS -----------------------------------------------------------------------
# The low-value exemption threshold (ISO-4217 cents) is a fixed connector constant of 3000:
# below it a low-value exemption is requested, at/above it a challenge is forced.

# --- Vendor transport ----------------------------------------------------------
# The single-vendor-call timeout is a HARDCODED constant (30000 ms) in the connector, not a
# deployment knob. The vendor SDK sets no timeout of its own, so without this a blackholed
# connection would hold a capture or refund open forever. A timeout is AMBIGUOUS — the vendor
# may have performed the operation and never answered — so the reserved amount stays fenced
# off instead of being released. The merchant panel's reconciliation window is DERIVED from it
# (this bound + 5 minutes).

# --- Brand identity -------------------------------------------------------------
# Brand IDENTITY is BRAND-ONLY (providers/psp/brand.defaults.json: displayName, paymentInterface,
# telemetryHeaderName, integrator, shoppingCartExtension, customObjectContainer, defaultHost /
# defaultHostLive, backOfficeTest / backOfficeLive, managePermission, paymentTypeKey). That file is
# AUTHORED — edit it in place; no env var overrides any of its values.

# --- Upstream template mock leftovers ------------------------------------------
# Still read into AppConfig by config.ts but unused by the payment flow. Leave empty.
MOCK_CLIENT_KEY=
MOCK_ENVIRONMENT=

# --- Merchant Center custom app (mc service) ------------------------------------
# Consumed at BUILD time by `mc-scripts build`, which compiles them into the
# production index.html (mc/custom-application-config.mjs). Changing them
# requires rebuilding the mc container.

# Custom Application ID issued by the Merchant Center when the app is registered
# under Organization settings > Custom Applications. Register the app FIRST (a
# placeholder URL is fine) to obtain this ID.
CUSTOM_APPLICATION_ID=[custom-application-id-from-merchant-center-org-settings]

# Must match the entryPointUriPath registered in the Merchant Center. It is baked into
# BOTH Merchant Center bundles at build time (mc/src/constants.ts reads it from the environment;
# mc-view/custom-view-config.mjs names its additional permission group after it), and the
# Merchant Center derives the manage permission from it — so it must stay paired with the brand
# default `managePermission` (canManage<TitleCase(entryPointUriPath)>), or every config
# mutation answers 403. This distribution's brand default is `canManageUnzerPayments`, so the
# entry point registered in the org must be `unzer-payments`.
ENTRY_POINT_URI_PATH=unzer-payments

# Merchant Center cloud identifier of the target region (adjust per region,
# for example: gcp-eu, gcp-us, gcp-au, aws-fra, aws-ohio).
CLOUD_IDENTIFIER=gcp-eu

# Public HTTPS URL where the built mc bundle is served. On-prem has no Connect
# to inject this: the merchant hosts the bundle behind the mandated TLS reverse
# proxy and registers this URL in the Merchant Center. Sequence: register first
# with a placeholder URL to obtain CUSTOM_APPLICATION_ID, deploy, then update
# the registration URL ("register-first, fix-URL-last"). The compose file maps
# this onto APPLICATION_URL for the mc service (each MC app has its own URL).
MC_APPLICATION_URL=[public-https-url-where-the-mc-bundle-is-served]

# Default project on local development login only; harmless in production.
CTP_INITIAL_PROJECT_KEY=[project-key]

# --- Merchant Center custom view (mc-view service) ------------------------------
# Consumed at BUILD time by `mc-scripts build` (mc-view/custom-view-config.mjs),
# same mechanics as the mc keys above. CLOUD_IDENTIFIER,
# CTP_INITIAL_PROJECT_KEY and ENTRY_POINT_URI_PATH are shared with the mc app —
# the entry point is set once and reaches both builds.

# Custom View ID issued by the Merchant Center when the view is registered under
# Organization settings > Custom Views. Register the view FIRST (a placeholder
# URL is fine) to obtain this ID. The placeholder renders on Order details >
# Payments (locator orders.order_details.payments).
CUSTOM_VIEW_ID=[custom-view-id-from-merchant-center-org-settings]

# Public HTTPS URL where the built mc-view bundle is served; mapped onto
# APPLICATION_URL for the mc-view service by the compose file. Same
# register-first, fix-URL-last sequence as the mc app.
MC_VIEW_APPLICATION_URL=[public-https-url-where-the-mc-view-bundle-is-served]
