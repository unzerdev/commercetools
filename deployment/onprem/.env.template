# On-prem env contract for the hardened stack — copy to `.env` and fill in. NO REAL VALUES HERE.
#
# This mirrors the connect.yaml key contract 1:1 (standardConfiguration + securedConfiguration) plus
# the on-prem-only front/scheduler/hosting keys. Secret material (marked SECRET) is supplied ONLY
# through this file at runtime; it is never baked into an image or passed as a build ARG.
#
# `.env` is git-ignored and must never be committed. Restrict its file permissions (chmod 600).

# ─── commercetools API client (processor) ────────────────────────────────────────────────────────
CTP_PROJECT_KEY=
CTP_CLIENT_ID=
CTP_CLIENT_SECRET=                      # SECRET
# {cloudRegion}.{cloudProvider} — the six commercetools URLs (auth/api/session/checkout + the MC-API
# jwks/jwtIssuer real merchant JWTs are validated against) are DERIVED from this one token. Set it to
# the project's own region; there is no default anywhere in the deployment contract.
CTP_REGION=europe-west1.gcp

# ─── Unzer credentials ───────────────────────────────────────────────────────────────────────────
# NOT environment variables: the Unzer key pair is entered per store in the Merchant Center
# application and stored encrypted in the unzer-connector-config Custom Object. The vendor API host,
# integrator identifier and telemetry header name are BRAND values
# (processor/src/providers/psp/brand.defaults.json). The webhook URL is DERIVED:
# {processor origin}/webhooks/{storeKey}/{token} (the token is a MAC derived from ENCRYPTION_KEY);
# a per-store `webhookUrl` override wins verbatim and must embed a valid token.

# ─── Return leg (public, structurally authenticated) ──────────────────────────────────────────────
# The processor's own /return base is DERIVED: {processor origin}/return.
PSP_ALLOWED_RETURN_ORIGINS=
PSP_RETURN_FAILURE_URL=
# The 3DS low-value threshold (3000 minor units) and the single-vendor-call timeout (30000 ms) are
# HARDCODED connector constants, not deployment knobs.

# ─── Encryption keyring ──────────────────────────────────────────────────────────────────────────
# REQUIRED: the CURRENT key of the encryption keyring. Per-store config
# secrets are AES-256-GCM encrypted at rest under it in the v1 key-id envelope
# (v1:<key-id>:<iv>:<tag>:<ciphertext>), so the connector cannot decrypt them without it. The boot
# guard refuses to start without it outright — and refuses a WEAK value (a placeholder or anything under 32 characters), because the
# webhook capability-URL token is derived from this key. Rotate via ENCRYPTION_KEY_PREVIOUS
# (zero-downtime), not by replacing it. Generate with:
# openssl rand -hex 32
ENCRYPTION_KEY=                         # SECRET
# OPTIONAL previous key of the encryption keyring — enables zero-downtime rotation. Decryption falls
# back to it by envelope key-id; new ciphertext is always written under the current ENCRYPTION_KEY.
# When set, post-deploy re-encrypts existing unzer-connector-config secrets under the current key
# and re-registers every credentialed store environment's webhook subscription with the current-key
# capability URL (best-effort, idempotent).
ENCRYPTION_KEY_PREVIOUS=                # SECRET

# ─── Config authorization ────────────────────────────────────────────────────────────────────────
# The MC permission an operator must hold on EVERY merchant /operations endpoint — the store connection
# (read/write the store config, testconnection, upload-logo, disconnect) AND the Merchant Center
# payment panel, which CAPTURES, REFUNDS and CANCELS real money — is a BRAND value
# (brand.defaults.json `managePermission`), not an env var. It is the permission claim commercetools
# derives from the mc app's entry point — can + Manage + PascalCase(ENTRY_POINT_URI_PATH) — so it stays
# in lockstep with ENTRY_POINT_URI_PATH below (unzer-payments -> canManageUnzerPayments). Grant it only
# to the MC Teams you trust to act on payments; the operator's MC Team must also be GRANTED it, else
# the gateway mints a token with no user_permissions claim and the routes 403.

# ─── Brand identity ──────────────────────────────────────────────────────────────────────────────
# Brand identity is BRAND-ONLY: display name, paymentInterface, telemetry header, integrator, cart
# extension, custom-object container, vendor hosts, back-office URLs, manage permission, payment-type
# key all ship in processor/src/providers/psp/brand.defaults.json, which is
# AUTHORED — edit it in place. No env var overrides any of them.

# ─── Merchant Center custom application (mc) — build-time, non-secret ─────────────────────────────
CUSTOM_APPLICATION_ID=
ENTRY_POINT_URI_PATH=unzer-payments
CLOUD_IDENTIFIER=gcp-eu
# Public HTTPS URL where the mc bundle is served (its own subdomain, fronted by nginx here).
MC_APPLICATION_URL=
# Processor /operations/* base URL both MC surfaces (mc, mc-view) forward to via the MC proxy — and
# the CSP connect-src each of them declares. Must be https: the forward-to proxy rejects http.
PROCESSOR_URL=

# ─── Merchant Center custom view (mc-view) — build-time, non-secret ──────────────────────────────
# Also consumes PROCESSOR_URL, CLOUD_IDENTIFIER and ENTRY_POINT_URI_PATH above — set the entry
# point ONCE, for both surfaces: the view names its additional permission group after it to mint the
# same canManageUnzerPayments the mc app's registration mints, and its build fails outright when the
# other three deployment keys are set and it is not.
CUSTOM_VIEW_ID=
MC_VIEW_APPLICATION_URL=

# ─── Front nginx (the only published service) ────────────────────────────────────────────────────
# The four public hostnames each proxied server matches (distinct DNS names / subdomains).
PUBLIC_PROCESSOR_HOST=
PUBLIC_ENABLER_HOST=
PUBLIC_MC_HOST=
PUBLIC_MC_VIEW_HOST=
NGINX_MAX_BODY_SIZE=6m
# Directory (host path) holding fullchain.pem + privkey.pem, mounted read-only into the front.
TLS_CERT_DIR=./tls
HTTP_BIND=0.0.0.0
HTTPS_BIND=0.0.0.0

# ─── Auto-capture scheduler ────────────────────────────────────────────────────────────
SCHEDULER_TARGET_PATH=/jobs/auto-capture
SCHEDULER_INTERVAL_SECONDS=60
SCHEDULER_TOKEN=                        # SECRET (when the auto-capture endpoint enforces a bearer, P5)

# ─── Base-image pins (see pin-digests.sh / runbook) ──────────────────────────────────────────────
# Replace the tags with immutable digests before production, e.g. node@sha256:...
NODE_IMAGE=node:22.14.0-alpine3.21
NGINX_IMAGE=nginxinc/nginx-unprivileged:1.27.4-alpine
ALPINE_IMAGE=alpine:3.21
