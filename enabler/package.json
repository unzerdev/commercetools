{
  "name": "enabler",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "serve public -l 8080 --cors",
    "dev": "vite build --watch & serve public -l 3000 --cors",
    "watch": "vite build --watch",
    "test": "jest --detectOpenHandles",
    "build": "tsc && vite build",
    "serve": "npm run build && serve public -l 3000 --cors",
    "lint": "prettier --check \"**/**/*.{ts,tsx,js,json,css}\" && eslint src test",
    "lint:fix": "prettier --write \"**/**/*.{ts,tsx,js,json,css}\" && eslint --fix src test"
  },
  "dependencies": {
    "@commercetools-backend/loggers": "27.17.0",
    "@sinclair/typebox": "0.34.52",
    "serve": "14.2.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "10.0.1",
    "@jest/globals": "30.5.2",
    "@types/node": "26.6.6",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jest": "29.17.0",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.14.0",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "prettier": "3.9.10",
    "sass": "1.108.1",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vite-plugin-css-injected-by-js": "5.0.3"
  },
  "overrides": {
    "path-to-regexp": "3.3.0",
    "lodash": "4.18.1",
    "brace-expansion": "1.1.18",
    "picomatch": "2.3.2"
  }
}
