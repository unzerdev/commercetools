{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,

    /* Linting */
    // "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "decs.d.ts"],

  /* Jest loads `jest.config.ts` through ts-node, which compiles it as CommonJS and from OUTSIDE the
     `include` above - so it inherits none of the options there. Without these it has no Node globals
     (`node:fs`, `node:path`, `__dirname`) and no module setting that permits the emit, and the whole
     suite fails to start on "Failed to parse the TypeScript config file". */
  "ts-node": {
    "compilerOptions": {
      "module": "CommonJS",
      "moduleResolution": "node",
      "types": ["node"],
      "allowImportingTsExtensions": false,
      "noEmit": false
    }
  }
}
