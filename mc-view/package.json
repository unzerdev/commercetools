{
  "name": "@psp/mc-view",
  "version": "0.0.1",
  "description": "",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "cross-env ENABLE_NEW_JSX_TRANSFORM=true mc-scripts build",
    "start": "cross-env ENABLE_NEW_JSX_TRANSFORM=true mc-scripts start",
    "serve": "mc-scripts serve",
    "start:patch": "node ../scripts/patch-mc-dev-app-url.js && mc-scripts start",
    "compile-html": "mc-scripts compile-html",
    "compile-html:local": "cross-env MC_APP_ENV=development mc-scripts compile-html --transformer @commercetools-frontend/mc-dev-authentication/transformer-local.js",
    "start:prod:local": "npm run compile-html:local && mc-scripts serve",
    "start:prod": "mc-scripts build && npm run compile-html && mc-scripts serve",
    "extract-intl": "formatjs extract --format=./intl-formatter.js --ignore='**/*.d.ts' --throws --out-file=./src/i18n/data/core.json 'src/**/!(*.spec).(ts|tsx)'",
    "test": "jest --config jest.test.config.js",
    "test:watch": "jest --config jest.test.config.js --watch",
    "lint": "eslint .",
    "format": "prettier --write '**/*.{js,ts,tsx}'",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "versions:appkit": "manypkg upgrade @commercetools-frontend",
    "versions:uikit": "manypkg upgrade @commercetools-uikit"
  },
  "dependencies": {
    "@babel/core": "^7.22.17",
    "@babel/runtime-corejs3": "^7.22.15",
    "@commercetools-frontend/actions-global": "^27.7.0",
    "@commercetools-frontend/application-components": "^27.7.0",
    "@commercetools-frontend/application-config": "^27.7.0",
    "@commercetools-frontend/application-shell": "^27.7.0",
    "@commercetools-frontend/application-shell-connectors": "^27.7.0",
    "@commercetools-frontend/assets": "^27.7.0",
    "@commercetools-frontend/babel-preset-mc-app": "^27.7.0",
    "@commercetools-frontend/constants": "^27.7.0",
    "@commercetools-frontend/eslint-config-mc-app": "^27.7.0",
    "@commercetools-frontend/i18n": "^27.7.0",
    "@commercetools-frontend/jest-preset-mc-app": "^27.7.0",
    "@commercetools-frontend/l10n": "^27.7.0",
    "@commercetools-frontend/mc-dev-authentication": "^27.7.0",
    "@commercetools-frontend/mc-scripts": "^27.7.0",
    "@commercetools-frontend/permissions": "^27.7.0",
    "@commercetools-uikit/card": "^20.4.0",
    "@commercetools-uikit/data-table": "^20.6.7",
    "@commercetools-uikit/design-system": "^20.4.0",
    "@commercetools-uikit/flat-button": "^20.4.0",
    "@commercetools-uikit/loading-spinner": "^20.4.0",
    "@commercetools-uikit/notifications": "^20.4.0",
    "@commercetools-uikit/spacings": "^20.4.0",
    "@commercetools-uikit/stamp": "^20.4.0",
    "@commercetools-uikit/text": "^20.4.0",
    "@commercetools/nimbus": "^3.2.0",
    "@emotion/react": "^11.14.0",
    "@formatjs/cli": "6.7.2",
    "@jest/types": "29.6.3",
    "@manypkg/cli": "0.25.0",
    "@tanstack/react-query": "^5.101.2",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "16.1.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@types/react-router": "^5.1.20",
    "@types/react-router-dom": "^5.3.3",
    "@types/testing-library__jest-dom": "^5.14.9",
    "eslint": "^9.0.0",
    "eslint-formatter-pretty": "4.1.0",
    "formik": "2.4.6",
    "jest": "30.2.0",
    "moment": "^2.29.4",
    "omit-empty-es": "1.2.0",
    "prettier": "2.8.8",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-intl": "^7.1.4",
    "react-redux": "9.2.0",
    "react-router-dom": "5.3.4",
    "redux": "5.0.1",
    "typescript": "5.9.2"
  },
  "resolutions": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@types/react-router": "<6",
    "@types/react-router-dom": "<6",
    "headers-polyfill": "3.2.5",
    "nwsapi": "2.2.7"
  },
  "devDependencies": {
    "cross-env": "^10.1.0"
  },
  "overrides": {
    "@types/json-stable-stringify": "1.0.36",
    "dompurify": "^3.4.14",
    "lodash": "^4.18.1",
    "qs": "^6.16.0",
    "eslint-plugin-jest-dom": "^5.10.1",
    "@visulima/boxen": "^3.1.0",
    "uuid@8": "^11.1.1"
  }
}
