# ==============================================================================
# Merchant Center Custom View (dev) env template — copy to `.env` and fill in real
# values. Never commit `.env` (it is gitignored; only this template is tracked).
#
# These keys are the local-development values custom-view-config.mjs reads from the
# environment; every one has a fallback there, so a checkout with no `.env` still
# builds (which is what `commercetools connect validate` does). Connect deployments
# override them at build/deploy time, and the four deployment keys must then be set
# TOGETHER: CUSTOM_VIEW_ID, APPLICATION_URL, PROCESSOR_URL and
# ENTRY_POINT_URI_PATH. Placeholders only — no real secrets in the template.
# ==============================================================================

ENABLE_NEW_JSX_TRANSFORM="true"
FAST_REFRESH="true"

# commercetools cloud region identifier (e.g. gcp-eu, aws-us).
CLOUD_IDENTIFIER="gcp-eu"

# commercetools project key the dev view opens against.
CTP_INITIAL_PROJECT_KEY="your-project-key"

# The mc config app's entryPointUriPath. MUST equal the processor's ENTRY_POINT_URI_PATH so the view's
# additionalOAuthScopes group mints canManage<TitleCase(...)> matching the processor's brand default
# `managePermission`.
ENTRY_POINT_URI_PATH="unzer-payments"

# Custom View id — a local placeholder in dev; the real id in a deployment.
CUSTOM_VIEW_ID="__local-development__"

# The view's own dev URL.
APPLICATION_URL="https://localhost:3001"

# The connector processor origin the panel reaches over the MC forward-to proxy, and
# the CSP connect-src origin declared in custom-view-config.mjs.
PROCESSOR_URL="http://localhost:8080"
